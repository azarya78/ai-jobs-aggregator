    {
      "id": "micro1_official_sitemap",
      "platform": "Micro1",
      "root": "https://jobs.micro1.ai",
      "sitemap": "https://jobs.micro1.ai/sitemap.xml",
      "jobPathPrefix": "/post/"
    }
  ]
}
